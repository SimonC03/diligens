# Copy to .env and fill in. Never commit .env.

# Anthropic API (console.anthropic.com). Used by agent/ at runtime.
ANTHROPIC_API_KEY=

# Model for flagging, questions and memo.
DILIGENS_MODEL=claude-sonnet-5-5

# SCB företagsregister API key (registreraafr.scb.se). Personal, do not share.
SCB_API_KEY=

# Bolagsverket API för värdefulla datamängder (free, after customer registration).
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
# test or prod
BOLAGSVERKET_ENV=test

# Where the app keeps analyses and screenings (local only, gitignored).
DILIGENS_WORKSPACE=data/private/arbetsyta
